*.swp

# Generated artifacts (keep saved models and data tracked intentionally)
results.txt

# Pure caches that rebuild in seconds:
#   python code/04_ml/chain_index.py --build
#   python code/04_ml/benchmark_v2.py --extra-train 1024
# train_extra.npz is an optional generated training split. It helped v5 but is
# not part of the frozen benchmark and rebuilds in about four seconds.
data/derived/chain_index/
data/derived/synth_v2/train_extra.npz
data/derived/bakeoff_cache/

# Rebuilt by code/04_ml/presentation_results.py for presentation figures.
data/derived/presentation_v5.npz

# Third-party baseline repos and their environments (cloned, never tracked).
# Provenance (repo URL, license, commit hash) is recorded in
# code/05_baselines/BASELINES.md.
.external/

# Per-trace KI-HMM v5 predictions for baseline subset comparisons. Rebuilt by
#   python code/05_baselines/v5_reference.py --splits test_x1,test_x2,test_x4
# (~25 min per split; compare_baselines.py falls back to the published metrics
# when the cache is absent).
code/05_baselines/results/v5_*_predictions.npz
